// Routing queries — routes, isochrones, waypoints, and travel analysis

// Simple driving route between two points
route(
  point(40.7128, -74.0060),
  point(40.7580, -73.9855)
);

// Walking route with keyword arguments
route(
  origin: point(48.8566, 2.3522),
  destination: point(48.8606, 2.3376),
  mode: "walk"
);

// Cycling route
route(
  origin: point(51.5074, -0.1278),
  destination: point(51.5155, -0.1419),
  mode: "bike"
);

// Drive around the polygons of a dataset (flood zones, closures, ...)
route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7580, -73.9855),
  avoid_datasets: ["flood-zones"]
);

// Turn-by-turn steps in German, distances in kilometres
route(
  origin: point(52.5163, 13.3777),
  destination: point(52.5219, 13.4132),
  steps: true,
  lang: "de"
);

// Navigation: voice and banner instructions, roundabout exit steps, a named destination
route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7580, -73.9855),
  steps: true,
  voice_instructions: true,
  banner_instructions: true,
  roundabout_exits: true,
  voice_units: "imperial",
  waypoint_names: ["", "Office"]
);

// 15-minute walking isochrone
isochrone(
  center: point(40.7128, -74.0060),
  time: 15,
  mode: "walk"
);

// Multiple isochrone rings
isochrone(
  center: point(48.8566, 2.3522),
  time: 5,
  mode: "walk"
);

// Find cafes along a route — using $$.name references
$$.route = route(
  point(40.7128, -74.0060),
  point(40.7580, -73.9855)
);
$$.cafes = search(node, amenity: "cafe")
  .around(100, $$.route)
  .limit(10);

// Find parks within a walking isochrone — $$.name as spatial filter
$$.walkable = isochrone(
  center: point(40.7128, -74.0060),
  time: 10,
  mode: "walk"
);
$$.parks = search(way, leisure: "park")
  .within($$.walkable);

// Map matching — snap GPS trace to road network
map_match(
  linestring(
    point(40.7128, -74.0060),
    point(40.7131, -74.0055),
    point(40.7135, -74.0048)
  ),
  mode: "drive"
);

// Optimize stop order (traveling salesman)
optimize(
  point(40.7128, -74.0060),
  point(40.7484, -73.9856),
  point(40.7580, -73.9855),
  point(40.7614, -73.9776),
  mode: "drive"
);

// Truck route: a 4 m, 30 t truck with a hazardous load
route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7580, -73.9855),
  mode: "truck",
  height: 4.0,
  weight: 30,
  hazmat: true
);

// Area a default semi-trailer reaches in 20 minutes
isochrone(center: point(40.7128, -74.0060), time: 1200, mode: "truck");

// Road bike that keeps off busy roads and steep climbs
route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7580, -73.9855),
  mode: "bicycle",
  bicycle_type: "road",
  use_roads: 0.2,
  use_hills: 0.1
);

// Adventure motorcycle ride over Alpine passes: curvy roads, tracks welcome
route(
  origin: point(46.5547, 8.5612),
  destination: point(46.6327, 8.6004),
  mode: "motorcycle",
  style: "adventure",
  use_curves: 1
);

// Scooter across Rome that keeps off fast main roads
route(
  origin: point(41.8902, 12.4922),
  destination: point(41.9109, 12.4818),
  mode: "motor_scooter",
  use_primary: 0,
  use_hills: 0.2
);

// Wheelchair route that prefers lit streets
route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7210, -73.9980),
  mode: "foot",
  wheelchair: true,
  use_lit: 1
);

// EV-aware routing with charge stops
ev_route(
  origin: point(40.7128, -74.0060),
  destination: point(42.3601, -71.0589),
  battery: 60000,
  mode: "auto"
);

// Distance matrix between multiple points
matrix(
  origins: [point(40.7128, -74.0060), point(40.7484, -73.9856)],
  destinations: [point(40.7580, -73.9855)]
);

// Meeting point for three friends on foot, then cafes near it
$meet = centroid(
  locations: [
    point(48.8584, 2.2945),
    point(48.8700, 2.3500),
    point(48.8450, 2.3400)
  ],
  mode: "foot"
);
search(node, amenity: "cafe").around(300, $meet).limit(5);

// Routing debug: every edge the router visited for a route
expansion(
  action: "route",
  origin: point(48.8584, 2.2945),
  destination: point(48.8700, 2.3500),
  expansion_properties: ["duration", "cumulative_cost"]
);

// Walk + public transit across Boston, leaving at 8 am local time
route(
  origin: point(42.3601, -71.0589),
  destination: point(42.3736, -71.1190),
  mode: "transit",
  depart_at: "2026-03-16T08:00:00",
  max_walk_m: 800,
  use_bus: 0.5
);

// Step-free transit trip that gets to Harvard by 9 am
route(
  origin: point(42.3601, -71.0589),
  destination: point(42.3736, -71.1190),
  mode: "transit",
  arrive_by: "2026-03-16T09:00:00-04:00",
  wheelchair: true
);

// Where 15 and 30 minutes of walking and transit get you
isochrone(
  center: point(42.3601, -71.0589),
  time: [900, 1800],
  mode: "transit",
  depart_at: "2026-03-16T08:00:00-04:00"
);

// Avoid tolls and keep under 100 km/h; also report the same route's time on foot
route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7580, -73.9855),
  use_tolls: 0,
  top_speed: 100,
  recostings: ["walk: mode=foot"]
);

// Pass a pickup point without stopping, and arrive with the door on the driving side
route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7580, -73.9855),
  waypoints: [point(40.7306, -73.9866)],
  location_types: ["break", "through", "break"],
  preferred_sides: ";;same"
);

// The same with Mapbox's approaches: arrive on the curb side
route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7580, -73.9855),
  approaches: ";curb"
);
