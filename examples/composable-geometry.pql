// Composable geometry — variables, constructors, set operations, multi-output
//
// Blank lines separate self-contained examples. Each one defines the
// variables it uses, so any block can be copied and run on its own.

// Variable assignment — store an area for reuse
$downtown = boundary(name: "Financial District, New York");
search(node, amenity: "cafe")
  .within($downtown)
  .limit(20);

// Inline polygon constructor — a custom area from corner points
search(node, amenity: "cafe")
  .within(polygon(
    point(40.710, -74.015),
    point(40.710, -73.995),
    point(40.725, -73.995),
    point(40.725, -74.015)
  ))
  .limit(20);

// Build a linestring from individual points and search along it
search(node, amenity: "restaurant")
  .around(200, linestring(
    point(40.7128, -74.0060),
    point(40.7300, -73.9950),
    point(40.7580, -73.9855)
  ))
  .fields("name", "cuisine")
  .limit(15);

// Area variables for complex spatial queries
// Search within Brooklyn but outside Prospect Park
$brooklyn = boundary(name: "Brooklyn, New York");
$prospect_park = boundary(name: "Prospect Park, Brooklyn");
search(node, amenity: "bar")
  .within($brooklyn)
  .not_within($prospect_park)
  .sort(t["name"])
  .limit(25);

// ── Set Operations ────────────────────────────────────────────

// Union (+) — combine two result sets
$downtown = boundary(name: "Financial District, New York");
$cafes = search(node, amenity: "cafe").within($downtown);
$restaurants = search(node, amenity: "restaurant").within($downtown);
$cafes + $restaurants;

// Difference (-) — subtract one set from another
$downtown = boundary(name: "Financial District, New York");
$all_food = search(node, amenity: ~"cafe|restaurant|fast_food")
  .within($downtown);
$fast_food = search(node, amenity: "fast_food")
  .within($downtown);
$all_food - $fast_food;

// Intersection (&) — features that appear in both sets
$downtown = boundary(name: "Financial District, New York");
$cafes = search(node, amenity: "cafe").within($downtown);
$italian = search(node, cuisine: "italian").within($downtown);
$cafes & $italian;

// Post-union tag filtering with .filter()
$downtown = boundary(name: "Financial District, New York");
$eating = search(node, amenity: "cafe").within($downtown)
        + search(node, amenity: "restaurant").within($downtown);
$eating.filter(wheelchair: "yes").limit(10);

// Route as geometry source — $$.name values are referenceable
// Use the output variable as a spatial filter
$$.route = route(
  origin: point(40.7128, -74.0060),
  destination: point(40.7580, -73.9855),
  mode: "bike"
);
$$.bike_parking = search(node, amenity: "bicycle_parking")
  .around(50, $$.route)
  .limit(10);

// Isochrone as geometry source
// Multiple named outputs referencing an earlier output
$$.walkable_area = isochrone(
  center: point(40.7128, -74.0060),
  time: 10,
  mode: "walk"
);
$$.parks = search(way, leisure: "park").within($$.walkable_area);
$$.transit = search(node, railway: "station").within($$.walkable_area);
$$.groceries = search(node, shop: "supermarket").within($$.walkable_area);

// Expand — recurse into relation members or way nodes
search(relation, name: "Central Park")
  .expand(:down)
  .limit(100);
